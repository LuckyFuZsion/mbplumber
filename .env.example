# Cloudinary: photo storage (https://console.cloudinary.com > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase: admin login + saved site content. See ADMIN_SETUP.md.
# Web config (public, safe to expose): Firebase console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# SECRET: service account JSON (Project settings > Service accounts > Generate new private key).
# Paste the whole JSON, or base64 of it. Never commit this.
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated emails allowed to sign in to /admin (must also exist as users in Firebase Auth)
ADMIN_EMAILS=

NEXT_PUBLIC_SITE_URL=https://www.mbplumber.co.uk
